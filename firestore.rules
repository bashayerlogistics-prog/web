rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must match VITE_SUPERADMIN_EMAIL (AdminAuthContext). UID is checked client-side
    // when VITE_SUPERADMIN_UID is set — requiring both here broke admin when env UID was empty/drifted.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'sulemanmr551@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBookingOwner() {
      return isSignedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    // Signed-in owner may attach payment proof + timeline only — cannot change ownership or order #.
    function isBookingProofUpdate() {
      return isBookingOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'paymentProofUrl',
            'paymentProofUploadedAt',
            'paymentStatus',
            'updatedAt',
            'trackingTimeline'
          ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.orderNumber == resource.data.orderNumber
        && (
          request.resource.data.paymentStatus == resource.data.paymentStatus
          || request.resource.data.paymentStatus == 'proof_submitted'
        );
    }

    // Bound list queries so clients cannot dump whole collections in one shot.
    function boundedList(max) {
      return request.query.limit != null && request.query.limit <= max;
    }

    function isValidPriceRequestCreate() {
      return request.resource.data.keys()
          .hasOnly(['name', 'phone', 'email', 'suggestedPrice', 'tripDetails', 'lang', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() < 40
        && request.resource.data.tripDetails is string
        && request.resource.data.tripDetails.size() > 0
        && request.resource.data.tripDetails.size() < 2000
        && request.resource.data.suggestedPrice is number
        && request.resource.data.suggestedPrice >= 0
        && request.resource.data.suggestedPrice < 10000000
        && (
          !('email' in request.resource.data)
          || request.resource.data.email == null
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() < 200
          )
        )
        && (
          !('lang' in request.resource.data)
          || (
            request.resource.data.lang is string
            && request.resource.data.lang.size() < 10
          )
        );
    }

    function isBookingCounterCreate(counterId) {
      return isSignedIn()
        && counterId == 'bookings'
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == 1;
    }

    function isBookingCounterBump(counterId) {
      return isSignedIn()
        && counterId == 'bookings'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
        && request.resource.data.last is int
        && request.resource.data.last == resource.data.get('last', 0) + 1;
    }

    // Order emails: signed-in users may only queue mail to their own address.
    // payment_confirmed / admin blasts stay admin-only.
    function isValidEmailQueueCreate() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.resource.data.keys()
          .hasOnly([
            'to', 'subject', 'html', 'text', 'from', 'fromName', 'replyTo',
            'type', 'bookingId', 'orderNumber', 'status', 'createdAt'
          ])
        && request.resource.data.status == 'queued'
        && request.resource.data.to is string
        && request.resource.data.to.size() > 3
        && request.resource.data.to.size() < 200
        && request.resource.data.to.lower() == request.auth.token.email.lower()
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() < 300
        && request.resource.data.html is string
        && request.resource.data.html.size() > 0
        && request.resource.data.html.size() < 100000
        && request.resource.data.type in ['order_placed', 'payment_pending']
        && (
          !('from' in request.resource.data)
          || request.resource.data.from == null
          || (
            request.resource.data.from is string
            && request.resource.data.from.size() < 200
          )
        )
        && (
          !('fromName' in request.resource.data)
          || request.resource.data.fromName == null
          || (
            request.resource.data.fromName is string
            && request.resource.data.fromName.size() < 120
          )
        )
        && (
          !('replyTo' in request.resource.data)
          || request.resource.data.replyTo == null
          || (
            request.resource.data.replyTo is string
            && request.resource.data.replyTo.size() < 200
          )
        )
        && (
          !('bookingId' in request.resource.data)
          || request.resource.data.bookingId == null
          || (
            request.resource.data.bookingId is string
            && request.resource.data.bookingId.size() < 128
          )
        );
    }

    function isValidUserActivityCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(['type', 'data', 'createdAt'])
        && request.resource.data.type in [
          'booking_created',
          'price_request_created',
          'payment_proof_submitted'
        ];
    }

    function isValidSelfNotificationCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.type is string
        && request.resource.data.type in ['payment_update', 'order_update', 'general']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000
        && (
          !('titleAr' in request.resource.data)
          || (
            request.resource.data.titleAr is string
            && request.resource.data.titleAr.size() < 200
          )
        )
        && (
          !('messageAr' in request.resource.data)
          || (
            request.resource.data.messageAr is string
            && request.resource.data.messageAr.size() < 2000
          )
        )
        && (
          !('bookingId' in request.resource.data)
          || request.resource.data.bookingId == null
          || (
            request.resource.data.bookingId is string
            && request.resource.data.bookingId.size() < 128
          )
        );
    }

    function isValidGuestChatCreate() {
      return request.resource.data.keys()
          .hasOnly([
            'conversationId', 'senderId', 'senderName', 'senderRole',
            'message', 'read', 'createdAt'
          ])
        && request.resource.data.senderRole in ['user', 'guest']
        && request.resource.data.read == false
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() > 8
        && request.resource.data.conversationId.size() < 128
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() < 80
        && (
          !('senderId' in request.resource.data)
          || request.resource.data.senderId == null
          || (
            request.resource.data.senderId is string
            && request.resource.data.senderId.size() < 128
          )
        );
    }

    // ── Users (Google/email signup writes own profile) ─────
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      // Login history is written by Cloud Functions (Admin SDK).
      match /loginActivity/{activityId} {
        allow get: if isAdmin() || isOwner(userId);
        allow list: if isAdmin() || (isOwner(userId) && boundedList(50));
        allow write: if false;
      }
    }

    // OTP hashes and rate limits are server-only. Cloud Functions use Admin SDK
    // and do not depend on client rules.
    match /otpChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /otpRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // ── Bookings — login required; userId must match auth ──
    match /bookings/{bookingId} {
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.userId == request.auth.uid);

      allow get: if isAdmin() || isBookingOwner();

      // Admin: paginated/live queries. Users: only own rows via where userId.
      allow list: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && boundedList(100)
        );

      allow update: if isAdmin() || isBookingProofUpdate();
      allow delete: if isAdmin();
    }

    // ── Price requests (public form → admin inbox) ─────────
    match /priceRequests/{requestId} {
      allow create: if isValidPriceRequestCreate();
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Public CMS (read anyone, write admin only) ─────────
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routeCards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /travelReservations/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────
    match /notifications/{notifId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid && boundedList(50));

      allow create: if isAdmin() || isValidSelfNotificationCreate();

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );

      allow delete: if isAdmin();
    }

    // ── Activity log ──────────────────────────────────────
    match /activityLog/{logId} {
      allow create: if isAdmin() || isValidUserActivityCreate();
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Order number counter (auth checkout transaction) ──
    match /counters/{counterId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isAdmin() || isBookingCounterCreate(counterId);
      allow update: if isAdmin() || isBookingCounterBump(counterId);
      allow delete: if isAdmin();
    }

    // ── Chat (guest widget + admin replies)
    // Guest widget queries by conversationId without auth — keep bounded list open
    // (Firestore rules cannot require a where filter). Create is tightly validated.
    match /chatMessages/{messageId} {
      allow get: if true;
      allow list: if isAdmin() || boundedList(100);
      allow create: if isAdmin() || isValidGuestChatCreate();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ── Email queue ───────────────────────────────────────
    // Admin (payment confirmed etc.) OR signed-in user emailing only themselves.
    match /emailQueue/{emailId} {
      allow create: if isAdmin() || isValidEmailQueueCreate();
      allow read, update, delete: if isAdmin();
    }
  }
}
